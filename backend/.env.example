NODE_ENV=development
PORT=5000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=investora_db
DB_USER=investora_user
DB_PASSWORD=investora_password

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production_12345
JWT_EXPIRATION=24h
REFRESH_TOKEN_EXPIRATION=7d

# Admin
ADMIN_PHONE=955748798

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Emails (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# WhatsApp/Telegram
WHATSAPP_API_KEY=
TELEGRAM_BOT_TOKEN=

# API
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
